#!/usr/bin/env bash
set -euo pipefail

UPDATE="${CHEZMOI_SYSTEM_UPDATE:-0}"

# NixOS
{{ if eq .chezmoi.osRelease.id "nixos" }}
exit 0
{{ end }}

echo "Installing native packages..."

# Arch-based
{{ if or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.id "cachyos") }}

if [ "$UPDATE" = "1" ]; then
  sudo pacman -Syu --noconfirm
else
  echo "Skipping system refresh+upgrade (CHEZMOI_SYSTEM_UPDATE!=1)"
fi

# install packages
pkgs=()
{{ range .packages.arch }}
pacman -Q "{{ . }}" &>/dev/null || pkgs+=("{{ . }}")
{{ end }}
((${#pkgs[@]})) && sudo pacman -S --noconfirm --needed "${pkgs[@]}"

# Paru + AUR
if command -v paru >/dev/null 2>&1; then
  echo "Paru is already installed."
else
  sudo pacman -S --noconfirm --needed git base-devel
  build_dir="$HOME/.cache/chezmoi-paru-build"
  rm -rf "$build_dir"
  mkdir -p "$build_dir"
  git clone https://aur.archlinux.org/paru.git "$build_dir"
  makepkg --dir "$build_dir" -si --noconfirm
  rm -rf "$build_dir"
fi

if [ "$UPDATE" = "1" ]; then
  paru -Su --noconfirm
else
  echo "Skipping paru upgrade (CHEZMOI_SYSTEM_UPDATE!=1)"
fi

# install AUR packages
aur_pkgs=()
{{ range .packages.aur }}
if ! pacman -Q "{{ . }}" &>/dev/null; then
  aur_pkgs+=("{{ . }}")
fi
{{ end }}

if [[ ${#aur_pkgs[@]} -gt 0 ]]; then
  echo "Installing AUR packages..."
  paru -S --noconfirm --needed "${aur_pkgs[@]}" 
fi
{{ end }}

# Go packages
go_pkgs=()

if ! command -v go >/dev/null 2>&1; then
  echo "Go is not installed, skipping packages installation..."
else
  # Install packages
  {{ range .packages.go }}
  name="{{ .id }}"

  # Update package version
  version=""
  if [ "$UPDATE" = "1" ]; then
    version="latest"
  else
    version="{{ .version | default "latest" }}" # default to latest instead of fail
  fi
  go install "${name}@${version}"
  {{ end }}
fi

# Nix packages
if ! command -v nix > /dev/null 2>&1; then
  echo "Nix is not installed, skipping packages installation..."
else
  FLAKE_DIR="$HOME/.config/nixpkgs"

  # Update profile
  if [ "$UPDATE" = "1" ]; then
    nix profile upgrade '.*'
  else
    echo "Skipping Nix profile upgrade (CHEZMOI_SYSTEM_UPDATE!=1)"
  fi

  # Install packages
  if [ -d "$FLAKE_DIR" ] && [ -f "$FLAKE_DIR/flake.nix" ]; then
    echo "Installing Nix packages..."
    nix profile install "$FLAKE_DIR" || true
  fi
fi

# Flatpak
if ! command -v flatpak > /dev/null 2>&1; then
  echo "Flatpak not installed, skipping apps installation..."
else
  if [ "$UPDATE" = "1" ]; then
    flatpak update -y --noninteractive
  else
    # install if missing only (your current check)
  fi
  {{ range .packages.flatpak_remotes }}
  flatpak remote-add --if-not-exists --system "{{ .name }}" "{{ .url }}" || true
  {{ end }}

  {{ range .packages.flatpak }}
  remote="{{ .remote | default "flathub" }}"
  branch="{{ .branch | default "stable" }}" 
  app="{{ .id }}"
  if ! flatpak info --system "$app//$branch" &>/dev/null; then
    echo "Installing Flatpak: $app ($remote/$branch)"
    flatpak install -y --system --noninteractive "$remote" "$app//$branch"
  fi
  {{ end }}
fi

echo "Done"
