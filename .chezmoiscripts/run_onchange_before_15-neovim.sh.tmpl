#!/usr/bin/env bash
set -euo pipefail

# Re-run when CHEZMOI_SYSTEM_UPDATE changes.
# {{ env "CHEZMOI_SYSTEM_UPDATE" | default "0" }}
{{ if eq .chezmoi.osRelease.id "nixos" }}
exit 0
{{ end }}

UPDATE="${CHEZMOI_SYSTEM_UPDATE:-0}"

echo "Installing Neovim..."

SRC_DIR="${HOME}/apps/neovim"
BIN_DIR="${HOME}/.local"
BIN_PATH="${BIN_DIR}/bin/nvim"
BUILD_TYPE="RelWithDebInfo"
BRANCH="master"

if [[ -x "${BIN_PATH}" && "$UPDATE" != "1" ]]; then
  echo "Neovim already installed at ${BIN_PATH}"
  echo "Skipping rebuild (CHEZMOI_SYSTEM_UPDATE!=1)"
  exit 0
fi

if [[ "$UPDATE" = "1" && -x "${BIN_PATH}" ]]; then
  echo "Updating Neovim at ${BIN_PATH}"
else
  echo "Installing Neovim from source"
fi
echo "Target folder: ${SRC_DIR}"
echo "Branch: ${BRANCH}"
echo "Build type: ${BUILD_TYPE}"

{{ if or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.id "cachyos") }}
sudo pacman -S --noconfirm --needed base-devel cmake ninja curl git
{{ end }}

mkdir -p "${HOME}/apps"

if [[ -d "${SRC_DIR}/src" ]]; then
  git -C "${SRC_DIR}/src" fetch --all --prune
  git -C "${SRC_DIR}/src" checkout "${BRANCH}"
  git -C "${SRC_DIR}/src" pull --ff-only
else
  git clone https://github.com/neovim/neovim.git "${SRC_DIR}/src"
  git -C "${SRC_DIR}/src" checkout "${BRANCH}"
fi

make -C "${SRC_DIR}/src" CMAKE_EXTRA_FLAGS="-DCMAKE_INSTALL_PREFIX=${BIN_DIR} -DMIN_LOG_LEVEL=1" CMAKE_BUILD_TYPE="${BUILD_TYPE}"
make -C "${SRC_DIR}/src" install

echo "Done"
